# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budget-app?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Budget App <reports@yourdomain.com>"

# OpenAI-compatible AI API (for AI Financial Assistant)
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Cron secret (protects the month-end report endpoint)
CRON_SECRET=replace-with-a-long-random-string

# Upstash Redis (rate limiting). Optional for local dev — falls back to an
# in-memory limiter if unset — but required in any multi-instance/production
# deployment. Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
